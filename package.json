{
  "name": "vinnoflow",
  "version": "1.0.0",
  "private": true,
  "description": "Vinnoflow — Telegram-powered cloud storage automation hub",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "cd frontend && npm run build",
    "start": "node backend/index.js",
    "dev": "npx concurrently \"npm run dev --workspace=frontend\" \"node backend/index.js\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "axios": "^1.18.1"
  }
}
